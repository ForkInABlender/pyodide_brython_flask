from flask import Flask, render_template
from flask_sock import Sock

app = Flask(__name__)
sock = Sock(app)

@app.route("/")
def index():
    return render_template("index2.html")

@sock.route("/ws")
def websocket(ws):
    while True:
        data = ws.receive()
        ws.send(f"/ws returned: {data}")

if __name__ == "__main__":
    app.run(host="127.0.0.1", port=5000, debug=True)
